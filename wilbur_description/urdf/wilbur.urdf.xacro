<?xml version="1.0"?>
<robot name="wilbur" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:arg name="tf_prefix" default="" />

    <xacro:arg name="ns" default="" />
    <xacro:arg name="sim_ignition" default="false" />
    <xacro:arg name="use_fake_hardware" default="true" /> <!-- todo look into calling this use_mock_hardware to be forward leaning-->
    <xacro:arg name="parent" default="world" />


    <!-- Includes -->
    <xacro:include filename="$(find clearpath_platform_description)/urdf/common.urdf.xacro" />
    <xacro:include filename="$(find wilbur_description)/urdf/w200.urdf.xacro" />
    <xacro:include
        filename="$(find wilbur_description)/urdf/attachments/bulkhead.urdf.xacro" />
    <xacro:include filename="$(find clearpath_platform_description)/urdf/links/frame.urdf.xacro" />

    <xacro:include filename="$(find clearpath_platform_description)/urdf/links/mesh.urdf.xacro" />

    <!--xacro:include
        filename="$(find clearpath_manipulators_description)/urdf/arm/universal_robots.urdf.xacro" /-->
    <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro" />

    <!-- Attachments -->
    <xacro:bulkhead
        name="bulkhead"
        model="$(arg tf_prefix)arm_plate"
        parent_link="$(arg tf_prefix)default_mount"
        tf_prefix="$(arg tf_prefix)">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:bulkhead>

    <!-- Links -->
    <!-- todo - reduce dependency on clearpath platform description buildin macros -->
    <xacro:mesh
        name="control_frame"
        parent_link="default_mount"
        visual="file://$(find wilbur_description)/meshes/control_frame.stl">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:mesh>

    <!-- todo - reduce dependency on clearpath platform description buildin macros -->
    <xacro:frame name="arm_0_end_effector" parent_link="arm_0_tool0">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:frame>

    <!-- Manipulators -->
    <xacro:property name="initial_positions_file" default="$(find wilbur_deploy)/config/ur_initial_positions.yaml" />
    <!-- todo expose out args for hardware-->
    <xacro:ur_robot
        name="arm_0_"
        tf_prefix="$(arg tf_prefix)arm_0_"
        parent="arm_plate_mount"
        use_fake_hardware="$(arg use_fake_hardware)"
        sim_ignition="$(arg sim_ignition)"
        initial_positions="${xacro.load_yaml(initial_positions_file)}"
        joint_limits_parameters_file="$(find ur_description)/config/ur10e/joint_limits.yaml"
        kinematics_parameters_file="$(find ur_description)/config/ur10e/default_kinematics.yaml"
        physical_parameters_file="$(find ur_description)/config/ur10e/physical_parameters.yaml"
        visual_parameters_file="$(find ur_description)/config/ur10e/visual_parameters.yaml"
        generate_ros2_control_tag="true"
      >
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:ur_robot>

    <!-- arm_0_gripper -->

    <!--xacro:robotiq_2f_85
    name="arm_0_gripper" parent_link="arm_0_end_effector_link">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:robotiq_2f_85-->

    <xacro:w200
        wheel="default"
        tf_prefix="$(arg tf_prefix)"
        sim_ignition="$(arg sim_ignition)"
        use_fake_hardware="$(arg use_fake_hardware)"
        ns="$(arg ns)"
    />

    <xacro:if value="$(arg sim_ignition)">
      <xacro:include filename="$(find wilbur_gz)/urdf/wilbur_gz.ros2_control.xacro" />
      <xacro:wilbur_gz_ros2_control
        gazebo_controllers_config_file="$(find wilbur_gz)/config/gazebo_controllers.yaml"
        ns="$(arg ns)"
      />
      <xacro:include filename="$(find wilbur_gz)/urdf/wilbur_gz.xacro" />
      <xacro:wilbur_gz/>
      
    </xacro:if>

</robot>