<?xml version="1.0"?>
<robot name="wilbur" xmlns:xacro="http://ros.org/wiki/xacro">
    <xacro:arg name="tf_prefix" default="" />

    <xacro:arg name="ns" default="" />
    <xacro:arg
        name="is_sim" default="true" />
    <xacro:arg name="parent" default="world" />
    <xacro:arg
        name="ur_type" default="ur10e" />

    <!-- Includes -->
    <xacro:include filename="$(find clearpath_platform_description)/urdf/common.urdf.xacro" />
    <xacro:include filename="$(find wilbur_description)/urdf/w200.urdf.xacro" />
    <xacro:include
        filename="$(find wilbur_description)/urdf/attachments/bulkhead.urdf.xacro" />
    <xacro:include filename="$(find clearpath_platform_description)/urdf/links/frame.urdf.xacro" />

    <xacro:include filename="$(find clearpath_platform_description)/urdf/links/mesh.urdf.xacro" />

    <!--xacro:include
        filename="$(find clearpath_manipulators_description)/urdf/arm/universal_robots.urdf.xacro" /-->
    <xacro:include
        filename="$(find ur_description)/urdf/ur_macro.xacro" />
    <!--xacro:include
        filename="$(find ur_description)/urdf/gripper/robotiq_2f_85.urdf.xacro" /-->

    <!-- Attachments -->
    <xacro:bulkhead
        name="bulkhead"
        model="$(arg tf_prefix)arm_plate"
        parent_link="$(arg tf_prefix)default_mount"
        tf_prefix="$(arg tf_prefix)">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:bulkhead>

    <!-- Links -->
    <xacro:mesh
        name="control_frame"
        parent_link="default_mount"
        visual="package://wilbur_description/meshes/control_frame.stl">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:mesh>

    <xacro:frame name="arm_0_end_effector" parent_link="arm_0_tool0">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:frame>

    <!-- Manipulators -->

    <xacro:ur_robot
        name="arm_0_"
        tf_prefix="$(arg tf_prefix)arm_0_"
        parent="arm_plate_mount"
        sim_ignition="true"
        joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
        kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
        physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
        visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:ur_robot>

    <!-- arm_0_gripper -->

    <!--xacro:robotiq_2f_85
    name="arm_0_gripper" parent_link="arm_0_end_effector_link">
        <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
    </xacro:robotiq_2f_85-->

    <xacro:w200
        tf_prefix="$(arg tf_prefix)"
        is_sim="$(arg is_sim)"
        ns="$(arg ns)"
    />
</robot>