<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
  https://github1s.com/clearpathrobotics/clearpath_common/blob/jazzy/clearpath_sensors_description/urdf/swiftnav_duro.urdf.xacro
  https://github1s.com/clearpathrobotics/clearpath_common/blob/jazzy/clearpath_sensors_description/urdf/gnss_antenna.urdf.xacro 
  -->
  <xacro:macro name="swiftnav_duro_gz" params="
    name
    tf_prefix=''
  "
  >
    <gazebo reference="${name}_link">
      <sensor name="${name}" type="navsat">
        <always_on>1</always_on>
        <update_rate>1</update_rate>
        <gz_frame_id>${name}_link</gz_frame_id>
        <topic>${tf_prefix}/sensors/${name}/navsat</topic>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>