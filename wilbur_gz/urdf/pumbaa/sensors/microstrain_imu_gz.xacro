<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <!--
  https://github1s.com/clearpathrobotics/clearpath_common/blob/jazzy/clearpath_sensors_description/urdf/microstrain_imu.urdf.xacro -->


  <xacro:macro name="microstrain_imu_gz"
    params="
      name 
      tf_prefix:=''
      update_rate:=100
    ">

    <gazebo reference="${name}_link">
      <sensor type="imu" name="${name}">
        <plugin filename="libgz-sim-imu-system.so" name="gz::sim::systems::Imu" />
        <always_on>true</always_on>
        <update_rate>${update_rate}</update_rate>
        <visualize>true</visualize>
        <gz_frame_id>${name}_link</gz_frame_id>
        <topic>${tf_prefix}/sensors/${name}/data_raw</topic>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>