<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="wilbur_gz_ros2_control" params="
    gazebo_controllers_config_file:=$(find wilbur_gz)/config/gazebo_controllers.yaml
    ns
  ">
    <gazebo>
      <!-- gazebo plugin to enable ros2 control for the system -->
      <plugin filename="libign_ros2_control-system.so"
        name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <parameters>$(arg gazebo_controllers_config_file)</parameters>
        <controller_manager_name>controller_manager</controller_manager_name>
        <ros>
          <remapping>~/odom:=odom</remapping>
          <remapping>~/cmd_vel_unstamped:=cmd_vel_unstamped</remapping>
          <remapping>/tf:=tf</remapping>
          <remapping>/tf_static:=tf_static</remapping>
          <remapping>/diagnostics:=diagnostics</remapping>
          <remapping>/dynamic_joint_states:=dynamic_joint_states</remapping>
          <remapping>joint_states:=joint_states</remapping>
          <remapping>~/reference:=cmd_vel</remapping>
          <remapping>~/odometry:=odom</remapping>
          <namespace>$(arg ns)</namespace>
        </ros>
      </plugin>
    </gazebo>

  </xacro:macro>

</robot>