<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="wilbur_gz_ros2_control" params="
    gazebo_controllers_config_file
    include_ur=true
    include_hande=false
    tf_prefix=''
    name='wilbur'
    ns
  ">

    <gazebo>
      <!-- gazebo plugin to enable ros2 control for the system -->
      <plugin filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${gazebo_controllers_config_file}</parameters>
        <controller_manager_name>controller_manager</controller_manager_name>
      </plugin>
    </gazebo>


    <ros2_control name="${name}" type="system">
      <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <xacro:if value="${include_ur}">
        <!--xacro:if value="${include_hande}">
          <xacro:include filename="$(find robotiq_hande_description)/urdf/robotiq_hande.ros2_control.xacro" />

          <xacro:robotiq_hande_ros2_control
              tf_prefix="${tf_prefix}"
              sim_ignition="true"
              use_fake_hardware="false"
              fake_sensor_commands="true"
          />
        </xacro:if-->
        <joint name="${tf_prefix}arm_0_shoulder_pan_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>

        <joint name="${tf_prefix}arm_0_shoulder_lift_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>


        <joint name="${tf_prefix}arm_0_elbow_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>


        <joint name="${tf_prefix}arm_0_wrist_1_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>


        <joint name="${tf_prefix}arm_0_wrist_2_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>


        <joint name="${tf_prefix}arm_0_wrist_3_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>


      </xacro:if>

      <joint name="${tf_prefix}front_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-25</param>
          <param name="max">25</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <joint name="${tf_prefix}rear_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-25</param>
          <param name="max">25</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <joint name="${tf_prefix}front_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-25</param>
          <param name="max">25</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>

      <joint name="${tf_prefix}rear_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-25</param>
          <param name="max">25</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>