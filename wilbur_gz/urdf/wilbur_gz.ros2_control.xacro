<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:macro name="wilbur_gz_ros2_control" params="
    gazebo_controllers_config_file
    include_ur=true
    tf_prefix=''
    name='wilbur'
    ns
  ">
    <gazebo>
      <!-- gazebo plugin to enable ros2 control for the system -->
      <plugin filename="libgz_ros2_control-system.so"
        name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>${gazebo_controllers_config_file}</parameters>
        <controller_manager_name>controller_manager</controller_manager_name>
        <ros>
          <remapping>~/odom:=odom</remapping>
          <remapping>~/cmd_vel_unstamped:=cmd_vel_unstamped</remapping>
          <remapping>/tf:=tf</remapping>
          <remapping>/tf_static:=tf_static</remapping>
          <remapping>/diagnostics:=diagnostics</remapping>
          <remapping>/dynamic_joint_states:=dynamic_joint_states</remapping>
          <remapping>joint_states:=joint_states</remapping>
          <remapping>~/reference:=cmd_vel</remapping>
          <remapping>~/odometry:=odom</remapping>
          <namespace>${ns}</namespace>
        </ros>
      </plugin>
    </gazebo>

    <ros2_control name="${name}" type="system">
      <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <xacro:if value="$(arg include_ur)">
        <joint name="${tf_prefix}arm_0_shoulder_pan_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>

        <joint name="${tf_prefix}arm_0_shoulder_lift_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>


        <joint name="${tf_prefix}arm_0_elbow_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>


        <joint name="${tf_prefix}arm_0_wrist_1_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>


        <joint name="${tf_prefix}arm_0_wrist_2_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>


        <joint name="${tf_prefix}arm_0_wrist_3_joint">
          <command_interface name="position" />
          <command_interface name="velocity" />
          <command_interface name="effort" />
          <state_interface name="position" />
          <state_interface name="velocity" />
          <state_interface name="effort" />
        </joint>

      </xacro:if>

      <joint name="${tf_prefix}front_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-25</param>
          <param name="max">25</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${tf_prefix}rear_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-25</param>
          <param name="max">25</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${tf_prefix}front_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-25</param>
          <param name="max">25</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
      <joint name="${tf_prefix}rear_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-25</param>
          <param name="max">25</param>
        </command_interface>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity">
          <param name="initial_value">0.0</param>
        </state_interface>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>