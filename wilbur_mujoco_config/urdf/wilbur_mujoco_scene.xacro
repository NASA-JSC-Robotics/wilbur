<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="wilbur_mujoco_scene">

    <!-- scene which describes general settings -->
    <scene>
        <statistic center="0.0 0 0.4" extent="5.0"/>
            <option gravity="0 0 -9.81">
                <flag contact="enable" />
            </option>

        <visual>
            <rgba haze="0.15 0.25 0.35 1"/>
            <!-- initial camera starting angle and elevation -->
            <global azimuth="-120" elevation="-30" offwidth="1280" offheight="720"/>
        </visual>

        <compiler angle="radian"/>

        <asset>
            <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
            <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.8 0.8 0.8" rgb2="0.8 0.8 0.8"
            markrgb="0.5 0.5 0.5" width="300" height="300"/>
            <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="3.0 3.0" reflectance="0.0"/>
        </asset>

        <worldbody>
            <light pos="0 0 3" dir="0 0 -1" directional="true" castshadow="false"/>
            <!-- Keeping the floor because the floor isn't defined in the URDF -->
            <geom name="floor" size="0 0 0.5" type="plane" material="groundplane" 
                  friction="1.5 0.1 0.05" 
                  solref="0.015 1" 
                  solimp="0.015 1 0.9 0.95 0.001"
                  condim="6" 
                  priority="1"/>
            <!-- recommended friction="1.5 0.01 0.005" solimp="0.99 0.995 0.001 0.5 2" solref="0.005 1" -->
             <!--  friction="0.4 0.05 0.01"  solimp="0.4 1.3 1.0 0.95 2.0" solref = "0.03 1.0"  -->
        </worldbody>
    </scene>

  </xacro:macro>
</robot>
