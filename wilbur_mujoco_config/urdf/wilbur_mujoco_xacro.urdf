<?xml version="1.0"?>
<robot name="wilbur" xmlns:xacro="http://ros.org/wiki/xacro">
  <!-- Includes -->
  <xacro:arg name="sim_speed" default="1.0" />
  <xacro:arg name="base_joint_type" default="floating"/>
  <xacro:arg name="use_pregenerated_mjcf" default="false"/>
  <xacro:arg name="include_ur" default="true" />

  <xacro:property name="force_abs_paths" value="False" scope="global" />

  <xacro:include filename="$(find wilbur_description)/urdf/wilbur.xacro" />

  <xacro:wilbur
    include_ur="$(arg include_ur)"
  />
  <!-- special inputs for mujoco processing-->
  <xacro:include
    filename="$(find wilbur_mujoco_config)/urdf/wilbur_mujoco_raw_inputs.xacro" />
  <xacro:include
    filename="$(find wilbur_mujoco_config)/urdf/wilbur_mujoco_processed_inputs.xacro" />
  <xacro:include filename="$(find wilbur_mujoco_config)/urdf/wilbur_mujoco_scene.xacro" />

  <mujoco_inputs>
        <raw_inputs>
            <xacro:wilbur_mujoco_raw_inputs />
        </raw_inputs>
        <processed_inputs>
            <xacro:wilbur_mujoco_processed_inputs />
        </processed_inputs>
        <xacro:wilbur_mujoco_scene />
    </mujoco_inputs>

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <xacro:if value="$(arg use_pregenerated_mjcf)">
        <param name="mujoco_model">$(find telehandler_mujoco_config)/mjcf_data/scene.xml</param>
      </xacro:if>
      <param name="sim_speed_factor">1.0</param>
    </hardware>

    <xacro:if value="$(arg include_ur)">
      <joint name="arm_0_finger_1_joint">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="arm_0_shoulder_pan_joint">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="arm_0_shoulder_lift_joint">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="arm_0_elbow_joint">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">${radians(-143)}</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="arm_0_wrist_1_joint">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="arm_0_wrist_2_joint">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">${radians(-90)}</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
      <joint name="arm_0_wrist_3_joint">
        <command_interface name="position" />
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity" />
        <state_interface name="effort" />
      </joint>
    </xacro:if>

    <joint name="front_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="front_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="rear_left_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>
    <joint name="rear_right_wheel_joint">
      <command_interface name="velocity" />
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity" />
      <state_interface name="effort" />
    </joint>


    <xacro:if value="$(arg include_ur)">
      <sensor name="arm_0_tcp_fts_sensor">
        <param name="mujoco_type">fts</param>
        <param name="mujoco_sensor_name">arm_0_tcp_fts_sensor</param>
        <state_interface name="force.x" />
        <state_interface name="force.y" />
        <state_interface name="force.z" />
        <state_interface name="torque.x" />
        <state_interface name="torque.y" />
        <state_interface name="torque.z" />
      </sensor>
    </xacro:if>

  </ros2_control>
</robot>